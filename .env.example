DISCORD_TOKEN=
GEMINI_API_KEY=
# Use a Gemini model available to your API account.
GEMINI_MODEL=gemini-3.8-flash
# Required: comma-separated channel/thread IDs. Each thread needs its own ID.
ALLOWED_CHANNEL_IDS=
# mention = mentions and replies to bot; always = every human message
REPLY_MODE=mention
COOLDOWN_SECONDS=5
MAX_OUTPUT_TOKENS=800
